{
  "expo": {
    "name": "WhisprNotes",
    "slug": "whisprnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whisprnotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WhisprNotes uses the microphone to record your notes. Audio is processed on this device and never uploaded.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Notes",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text",
              "net.daringfireball.markdown",
              "public.zip-archive",
              "public.xml"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "bundleIdentifier": "com.mdhamed.off.audiotranscriptionapp",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FF6A4D"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "package": "com.mdhamed.off.audiotranscriptionapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/x-markdown"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            }
          ]
        }
      ],
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "WhisprNotes uses the microphone to record your notes. Audio is processed on this device and never uploaded.",
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback",
            "microphone"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF6A4D",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#2A1D3A"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@kesha-antonov/react-native-background-downloader",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "es",
              "de",
              "it",
              "ar",
              "pt",
              "nl",
              "tr",
              "ru",
              "hi",
              "ja",
              "ko",
              "zh-Hans",
              "pl",
              "id",
              "uk",
              "sv",
              "vi",
              "cs"
            ],
            "android": [
              "en",
              "fr",
              "es",
              "de",
              "it",
              "ar",
              "pt",
              "nl",
              "tr",
              "ru",
              "hi",
              "ja",
              "ko",
              "zh-Hans",
              "pl",
              "id",
              "uk",
              "sv",
              "vi",
              "cs"
            ]
          }
        }
      ],
      "./plugins/withBackupRules"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCat": {
        "iosKey": "",
        "androidKey": ""
      },
      "eas": {
        "projectId": "1413e1b9-5c48-4d16-8bcc-fbc348bb68b2"
      }
    },
    "owner": "mdhamed238",
    "locales": {
      "fr": "./i18n/native/fr.json",
      "es": "./i18n/native/es.json",
      "de": "./i18n/native/de.json",
      "it": "./i18n/native/it.json",
      "ar": "./i18n/native/ar.json",
      "pt": "./i18n/native/pt.json",
      "nl": "./i18n/native/nl.json",
      "tr": "./i18n/native/tr.json",
      "ru": "./i18n/native/ru.json",
      "hi": "./i18n/native/hi.json",
      "ja": "./i18n/native/ja.json",
      "ko": "./i18n/native/ko.json",
      "zh-Hans": "./i18n/native/zh-Hans.json",
      "pl": "./i18n/native/pl.json",
      "id": "./i18n/native/id.json",
      "uk": "./i18n/native/uk.json",
      "sv": "./i18n/native/sv.json",
      "vi": "./i18n/native/vi.json",
      "cs": "./i18n/native/cs.json"
    }
  }
}
