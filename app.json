{
  "expo": {
    "name": "WhisprNotes",
    "slug": "whisprnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whisprnotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WhisprNotes uses the microphone to record your notes. Audio is processed on this device and never uploaded.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Notes",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text",
              "net.daringfireball.markdown",
              "public.zip-archive",
              "public.xml"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "bundleIdentifier": "com.mdhamed.off.audiotranscriptionapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FF6A4D"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "package": "com.mdhamed.off.audiotranscriptionapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/x-markdown"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            }
          ]
        }
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "WhisprNotes uses the microphone to record your notes. Audio is processed on this device and never uploaded.",
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback",
            "microphone"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF6A4D",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#2A1D3A"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@kesha-antonov/react-native-background-downloader",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCat": {
        "iosKey": "",
        "androidKey": ""
      },
      "eas": {
        "projectId": "1413e1b9-5c48-4d16-8bcc-fbc348bb68b2"
      }
    },
    "owner": "mdhamed238"
  }
}
